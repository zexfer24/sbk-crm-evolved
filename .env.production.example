# Copia este archivo a .env.production y complétalo.
#
# Antes de desplegar:  ./scripts/preflight.sh
#
# .env.production NO se versiona: lleva las llaves del negocio.

# --- Dominio ----------------------------------------------------------------
# Tiene que apuntar ya a este servidor: Caddy le pide el certificado TLS a
# Let's Encrypt al arrancar y falla si el DNS todavía no resuelve acá.
DOMAIN=crm.tudominio.com

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS por completo. Solo servidor, nunca en un build-arg ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Meta) --------------------------------------------------------
# OBLIGATORIA: sin ella el webhook responde 503 y no procesa nada.
WHATSAPP_APP_SECRET=
# Token permanente de System User. El del panel de desarrollo dura 24 horas.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Plantilla aprobada en Meta que se manda cuando alguien escribe con la ventana
# de 24 h cerrada. Vacía = no se manda nada.
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE_LANG=es

# Techo de eventos por minuto en el webhook. 120 es holgado para una
# repuestera; corta un bucle de reintentos antes de que dispare cientos de
# turnos de IA.
WHATSAPP_WEBHOOK_RATE_LIMIT=120

# --- Agente de IA -----------------------------------------------------------
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cola de turnos ---------------------------------------------------------
# Cadena larga y aleatoria:  openssl rand -hex 32
# Sin ella /api/cron/process-queue responde 503: ese endpoint dispara turnos
# de IA, o sea gasto.
CRON_SECRET=

# --- Zona horaria -----------------------------------------------------------
NEXT_PUBLIC_CRM_TIME_ZONE=America/Caracas

# ---------------------------------------------------------------------------
# Redis · cola de turnos del agente
#
# Tiene que correr con persistencia AOF (`--appendonly yes`): sin ella, un
# reinicio se lleva los turnos pendientes y esos clientes se quedan sin
# respuesta.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# Turnos que pueden hablar con el modelo a la vez, en todo el sistema. Subirlo
# acelera los picos pero acerca el rate limit del proveedor.
AGENT_MAX_CONCURRENT_TURNS=3
