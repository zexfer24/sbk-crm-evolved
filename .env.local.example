# Copia este archivo a .env.local
# Valores por defecto de `npx supabase start` (instancia local vía Docker).
# Ejecuta `npx supabase status` para confirmarlos o regenerarlos.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta) — opcional, solo si vas a conectar un canal real.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# OBLIGATORIA EN PRODUCCIÓN. "App secret" de la app de Meta (Configuración >
# Básica). Con ella el webhook verifica la firma X-Hub-Signature-256 y
# descarta cualquier request que no venga de Meta. Si se deja vacía, el
# webhook ACEPTA CUALQUIER POST: quien descubra la URL puede inyectar
# mensajes falsos, hacer que la IA le responda a clientes inventados y
# gastar tu cuota del modelo. Vacía solo en desarrollo local, donde Meta
# nunca llega a llamar el endpoint.
WHATSAPP_APP_SECRET=

# Bienvenida automática: nombre de la plantilla aprobada en Meta que se envía
# cuando un cliente escribe con la ventana de 24 h cerrada (incluida la primera
# vez que escribe). Si se deja vacía, no se envía ninguna bienvenida.
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE_LANG=es

# Zona horaria del equipo. Define el día y las horas del gráfico del dashboard.
NEXT_PUBLIC_CRM_TIME_ZONE=America/Caracas

# Agente de IA (SBK Motorcycles) — proveedor y modelo se leen en tiempo de
# ejecución, sin tocar código. En producción: openai / gpt-5.6-luna. En
# desarrollo: google / gemini-3.1-flash-lite. Si se omite AI_AGENT_PROVIDER,
# se deduce del prefijo del model id ("gemini*" -> google, si no -> openai).
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo de las dos fases de clasificación (reconocer escenario y clasificar
# intención). Vacío = el mismo del agente, que es lo que corre hoy. Está para
# poder mover SOLO la clasificación a un modelo más barato y con otro techo de
# ritmo, en una línea y sin tocar código.
AI_CLASSIFIER_MODEL=

# Secreto del cron que procesa la cola de turnos de la IA. Cadena larga y
# aleatoria. Sin ella /api/cron/process-queue responde 503 y no procesa nada:
# ese endpoint dispara turnos de IA, o sea gasto.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Redis · cola de turnos del agente
#
# Tiene que correr con persistencia AOF (`--appendonly yes`): sin ella, un
# reinicio se lleva los turnos pendientes y esos clientes se quedan sin
# respuesta.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# Turnos que pueden hablar con el modelo a la vez, en todo el sistema. Acota
# cuánta conversación tiene el sistema abierta a la vez; el ritmo hacia el
# proveedor lo controlan las dos variables de más abajo.
AGENT_MAX_CONCURRENT_TURNS=3

# Turnos que pueden SALIR por minuto, en todo el sistema. Es un freno distinto
# del de arriba y hacen falta los dos: los cupos limitan turnos SIMULTÁNEOS, y
# con tres cupos y turnos de siete segundos caben veinticinco en un minuto.
# Bajo a propósito: es lo que hace que apagar el interruptor alcance a frenar
# algo. Subirlo acelera el drenado del atraso y encarece cualquier error.
AGENT_MAX_TURNS_PER_MINUTE=4

# --- Ritmo hacia el proveedor del modelo ------------------------------------
# El único freno que cuenta PETICIONES (AGENT_MAX_CONCURRENT_TURNS cuenta
# turnos, y un turno gasta hasta siete peticiones). Ver src/lib/ai/rate-limit.ts.
#
# El objetivo por minuto va DEBAJO del techo real del proveedor a propósito:
# los reintentos también gastan cuota, y sin margen el primer 429 deja el turno
# sin forma de recuperarse. Con un techo de 20/min, 15 es el número.
AI_MAX_CONCURRENT_REQUESTS=3
AI_MAX_REQUESTS_PER_MINUTE=15

