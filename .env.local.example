# Copia este archivo a .env.local
# Valores por defecto de `npx supabase start` (instancia local vía Docker).
# Ejecuta `npx supabase status` para confirmarlos o regenerarlos.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta) — opcional, solo si vas a conectar un canal real.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# OBLIGATORIA EN PRODUCCIÓN. "App secret" de la app de Meta (Configuración >
# Básica). Con ella el webhook verifica la firma X-Hub-Signature-256 y
# descarta cualquier request que no venga de Meta. Si se deja vacía, el
# webhook ACEPTA CUALQUIER POST: quien descubra la URL puede inyectar
# mensajes falsos, hacer que la IA le responda a clientes inventados y
# gastar tu cuota del modelo. Vacía solo en desarrollo local, donde Meta
# nunca llega a llamar el endpoint.
WHATSAPP_APP_SECRET=

# Bienvenida automática: nombre de la plantilla aprobada en Meta que se envía
# cuando un cliente escribe con la ventana de 24 h cerrada (incluida la primera
# vez que escribe). Si se deja vacía, no se envía ninguna bienvenida.
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE_LANG=es

# Zona horaria del equipo. Define el día y las horas del gráfico del dashboard.
NEXT_PUBLIC_CRM_TIME_ZONE=America/Caracas

# Agente de IA (SBK Motorcycles) — proveedor y modelo se leen en tiempo de
# ejecución, sin tocar código. En producción: openai / gpt-5.6-luna. En
# desarrollo: google / gemini-3.1-flash-lite. Si se omite AI_AGENT_PROVIDER,
# se deduce del prefijo del model id ("gemini*" -> google, si no -> openai).
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo de las dos fases de clasificación (reconocer escenario y clasificar
# intención). Vacío = el mismo del agente, que es lo que corre hoy. Está para
# poder mover SOLO la clasificación a un modelo más barato y con otro techo de
# ritmo, en una línea y sin tocar código.
AI_CLASSIFIER_MODEL=

# on|off. Con on (o vacío, o cualquier otro valor), el agente y el
# clasificador mandan `reasoningEffort` al proveedor OpenAI, como siempre.
# Poner off NO cambia de modelo -- solo deja de mandar ese parámetro. Existe
# porque producción corre gpt-5.6-luna a través de OpenRouter, un modelo que
# no razona: mandarle reasoningEffort igual solo hacía que el AI SDK avisara
# "reasoningEffort is not supported" 3-4 veces por turno sin que el esfuerzo
# se aplicara (medido 7/9/2026). En local, con OpenAI directo o con Gemini,
# dejar en on/vacío.
AI_AGENT_REASONING=on

# Minutos de gracia: cuánto tiempo después de escribir sigue "conversando
# ahora" un asesor, aunque su mensaje sea anterior al último del cliente. Un
# valor ausente, vacío, no numérico, cero o negativo cae al default (30) —
# ver human-handled.ts (T7, "La IA ve lo que llega", 8/9/2026). Subirla sin
# redeploy si aparece `turno_persona_se_adelanto` sobre un chat que un
# asesor está atendiendo AHORA MISMO: significa que 30 minutos se quedaron
# cortos para ese ritmo de conversación.
AI_HUMAN_GRACE_MINUTES=30

# Secreto del cron que procesa la cola de turnos de la IA. Cadena larga y
# aleatoria. Sin ella /api/cron/process-queue responde 503 y no procesa nada:
# ese endpoint dispara turnos de IA, o sea gasto.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Redis · cola de turnos del agente
#
# Tiene que correr con persistencia AOF (`--appendonly yes`): sin ella, un
# reinicio se lleva los turnos pendientes y esos clientes se quedan sin
# respuesta.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Las cinco variables de abajo van SIEMPRE juntas: las tres primeras acotan
# TURNOS y las dos últimas PETICIONES al proveedor, y un turno gasta hasta
# siete peticiones (escenario, clasificación, hasta cinco pasos del tool
# loop). Subir solo unas sin las otras no acelera nada — solo mueve dónde
# aparece el freno (`cola_ritmo_al_tope` si el cuello es la cola,
# `ia_ritmo_al_tope` durmiendo hasta 60 s DENTRO del turno si el cuello es el
# proveedor, peor porque el turno queda tomado todo ese rato).
#
# Historia (7/9/2026, "La respuesta llega en siete segundos"): con
# AGENT_MAX_TURNS_PER_MINUTE=4 medido contra producción, la cola —no el
# modelo— era la espera: 11,2 min de mediana, p90 32 min, hasta 90 min con 360
# turnos acumulados (una noche, o la IA volviendo de estar apagada). El techo
# de 20 peticiones/min que justificaba AI_MAX_REQUESTS_PER_MINUTE=15 tampoco
# existe: `https://openrouter.ai/api/v1/key` contra la llave de producción
# devuelve `is_free_tier: false`, `limit: null` (`rate_limit` viene
# deprecado) — era de la cuenta gratuita. La demanda real medida ese día fue
# 2,54 conversaciones/min de media con picos de 6.
#
# Vuelta atrás si algo sale mal: bajar AGENT_MAX_TURNS_PER_MINUTE en Dokploy
# (o en este archivo) es el freno más rápido — se lee en cada pasada de la
# cola, así que no hace falta tocar código ni base — pero el Environment de
# Dokploy solo llega al contenedor con un redeploy (~20 s de corte, sin
# rebuild de imagen si no cambió el código). El freno de emergencia real, en
# cualquier valor, sigue siendo agent_can_run() (interruptor global + tope de
# gasto diario), consultado en CADA turno.
# ---------------------------------------------------------------------------

# Turnos que pueden hablar con el modelo a la vez, en todo el sistema. Acota
# cuánta conversación tiene el sistema abierta a la vez; el ritmo hacia el
# proveedor lo controlan las dos variables AI_MAX_* de más abajo.
AGENT_MAX_CONCURRENT_TURNS=8

# Turnos que pueden SALIR por minuto, en todo el sistema. Mide cola ÷ este
# número: era el cuello real medido el 7/9/2026 (ver arriba).
AGENT_MAX_TURNS_PER_MINUTE=30

# Tope de turnos que una sola pasada de la cola atiende (el webhook tras su
# propio debounce, o el cron). Antes fijo en diez; ahora también sale del
# entorno, con el mismo patrón que las de arriba.
AGENT_QUEUE_MAX_PER_RUN=30

# --- Ritmo hacia el proveedor del modelo ------------------------------------
# El único freno que cuenta PETICIONES (AGENT_MAX_CONCURRENT_TURNS cuenta
# turnos). Ver src/lib/ai/rate-limit.ts y el bloque de arriba.
AI_MAX_CONCURRENT_REQUESTS=12
AI_MAX_REQUESTS_PER_MINUTE=120

