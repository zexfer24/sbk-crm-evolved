# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Certificados PÚBLICOS de prueba de la cadena TLS del BCV (21/11/2026): sin
# esta excepción el CI no los recibía y los tests de bcv-fetch/bcv-chain caían
# con ENOENT. Las llaves privadas nunca se guardan (el script las borra).
!src/lib/ai/__fixtures__/bcv-certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos las plantillas, que no llevan ningún valor y son la única lista de
# variables que tiene quien clone el repo.
!.env.local.example
!.env.production.example

# Respaldos de la base: nunca al repositorio.
/backups/

# Export de historiales reales para el comparador de clasificador (T2, "La
# respuesta llega en siete segundos", 7/9/2026): trae texto real de clientes,
# nunca al repositorio. El reporte que genera el comparador tampoco -- puede
# citar ese mismo texto en los ejemplos de desacuerdo.
/scripts/historiales-clasificador.json
/scripts/comparar-clasificador.reporte.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramental local de skills: .claude/skills son symlinks con rutas
# absolutas de esta máquina, no sirven en ninguna otra.
/.agents/
/.claude/skills/
skills-lock.json

# Material privado del rework de Seba (conversaciones reales, casos del arnés,
# pautas con identificadores de chats): el repositorio es público.
# Excepción (17/11/2026): el ejemplo sintético del arnés de turnos, con casos
# INVENTADOS, sí se versiona. Se ignora el contenido de `privado/` y de
# `privado/seba-v2/` por separado: git no puede reincluir un archivo dentro de
# un directorio ya ignorado entero.
/privado/*
!/privado/seba-v2/
/privado/seba-v2/*
!/privado/seba-v2/ejemplo.sintetico.jsonl

# Credenciales del equipo: contraseñas en texto plano, nunca al repositorio.
CREDENCIALES.txt
.liminal/
