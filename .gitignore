# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos las plantillas, que no llevan ningún valor y son la única lista de
# variables que tiene quien clone el repo.
!.env.local.example
!.env.production.example

# Respaldos de la base: nunca al repositorio.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramental local de skills: .claude/skills son symlinks con rutas
# absolutas de esta máquina, no sirven en ninguna otra.
/.agents/
/.claude/skills/
skills-lock.json
